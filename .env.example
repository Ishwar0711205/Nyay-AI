# ==============================================================================
# NYAY AI — Environment Configuration Template
# ==============================================================================
# 1. Rename or copy this file to .env (e.g. run "copy .env.example .env")
# 2. Add your Gemini API key from https://aistudio.google.com/
# ==============================================================================

# Gemini API Key (Required - obtain free from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Recommended Model (verified for accuracy, latency, and free tier compatibility)
GEMINI_MODEL=gemini-3.5-flash-lite

# JWT Secret for session authentication (generate a 32+ character random string)
JWT_SECRET=NyayAI_Secure_Local_Secret_Key_ChangeInProd_2026

# Session duration in hours
JWT_EXPIRE_HOURS=24

# Official ChromaDB Vector Database (Preloaded with 65 Maharashtra statutes & 5,259 chunks)
CHROMA_PATH=database/chroma_final
CHROMA_COLLECTION=nyay_ai_final

# User Upload Vector Database (Isolated per-user document workspace)
USER_CHROMA_PATH=database/user_upload_chroma

# Local SQLite Authentication Database (Auto-created on first run)
AUTH_DB=database/auth.sqlite3

# Embedding Model (SentenceTransformers MiniLM-L6-v2)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173
